# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets — never commit real keys
.env
.streamlit/secrets.toml

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated reports (keep the folder, ignore contents)
reports/*
!reports/.gitkeep

# Benchmark dataset dumps (regenerable; results.csv/md stay tracked)
benchmark/dataset/

# Sample images (regenerable from scikit-image's bundled data)
sample_images/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Docs: track the published reference documentation only.
# (Allowlist — add a negation line to publish another file.)
docs/*
!docs/architecture.md
!docs/user_guide.md
!docs/results_guide.md
!docs/system_design.svg
!docs/screenshots/

# Downloaded benchmark datasets (regenerable)
data/
