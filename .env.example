# SciFlow Agent configuration — copy to .env and adjust.
# All values below are placeholders; the app runs with zero configuration in demo mode.

# Planner mode: "demo" (deterministic, no API key required) or "llm"
PLANNER_MODE=demo

# OpenAI-compatible endpoint settings (used only when PLANNER_MODE=llm)
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model-name
# Request timeout in seconds for LLM calls (local models can be slow)
LLM_TIMEOUT_SECONDS=120

# Safety limits
MAX_WORKFLOW_STEPS=8
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096

# Logging
LOG_LEVEL=INFO
